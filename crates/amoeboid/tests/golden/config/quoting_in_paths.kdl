// amoeboid run configuration (KDL v2). Read once per command, never hot-reloaded.
// amoeboid rewrites this file when it saves a setting itself, keeping only this header
// comment. Run `amoeboid config --help` for what each key means.

user "u"
uid 2
gid 2
base-nix-config "/srv/q\"uote"
(list)default-mounts {
    - {
        path "/srv/say \"hi\""
        mode "rw"
    }
    - {
        path "/srv/back\\slash"
        mode "ro"
    }
    - {
        path "/srv/tab\there"
        mode "rw"
    }
    - {
        path "/srv/new\nline"
        mode "ro"
    }
}
(list)home-files {
    - "dir/q\"uote"
    - "dir\\back"
    - "tab\tfile"
    - "keyword/true"
}
ssh {
    port 0
}
timeouts {
    boot 180
    stop 60
}
