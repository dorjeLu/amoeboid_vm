# Host-specific settings for amoeboid VMs, rendered from amoeboid's host.nix.template
# on first run. amoeboid never overwrites this file; edit it freely. It is merged into
# every VM after the recipe, so it is also the place for per-machine tweaks, e.g.
#
#   microvm.vcpu = 4;
#   microvm.mem = 4096; # MiB; avoid exactly 2048, qemu hangs
{ ... }:

{
  # The guest user; matches the owner of the shared directories on the host.
  amoeboid.user = "@user@";
  amoeboid.uid = @uid@;
  amoeboid.gid = @gid@;
}
